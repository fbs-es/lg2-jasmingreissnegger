{
  "metadata": [
    {
      "src": [
        {
          "src": "../",
          "files": [
            "PaymentService.csproj"
          ]
        }
      ],
      "dest": "api",
      "outputFormat": "mref",
      "properties": {
        "TargetFramework": "net8.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/index.md"
        ]
      },
      {
        "files": [
          "index.md"
        ]
      }
    ],
    "dest": "_site",
    "template": [
      "default"
    ]
  }
}
